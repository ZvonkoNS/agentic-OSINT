  "assertions": [
    {
      "id": "ONI-01",
      "step": "S1",
      "description": "address format valid (56 base32 + .onion)",
      "path": "/values/S1/address_format_valid_56_base32_onion",
      "required": true,
      "check": "equals",
      "expect": true
