    {
      "id": "ONI-02",
      "step": "S1",
      "description": "version byte",
      "path": "/values/S1/version_byte",
      "required": true,
      "check": "equals",
      "expect": 3
    },
    {
      "id": "ONI-03",
      "step": "S1",
      "description": "checksum valid (if computed)",
      "path": "/values/S1/checksum_valid_if_computed",
      "required": true,
      "check": "in",
      "expect": [
        true,
        "not verified"
      ]
    },
    {
      "id": "ONI-04",
      "step": "S5",
      "description": "clearnet search result page captured",
      "path": "/values/S5/clearnet_search_result_page_captured",
      "required": true,
      "check": "gte",
      "expect": 1
    },
    {
      "id": "ONI-05",
      "step": "unit",
      "description": "validation routine applied to the v2 address expyuzz4wqqyqhjn.onion (code only)",
      "path": "/values/unit/validation_routine_applied_to_the_v2_address_expyuzz4wqqyqhjn_onion_code_only",
      "required": true,
      "check": "equals",
      "expect": "NOT-INVESTIGABLE"
    }
  ]
