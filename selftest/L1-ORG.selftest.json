{
  "schema": "l1-selftest/1.3",
  "agent": "L1-ORG",
  "agent_version": "1.3.3",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "Apple Inc.",
  "skip_steps": [
    "S5",
    "S7",
    "S8"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {
    "16": "US",
    "17": "LEI HWUPKR0MPOU8FGXBT394; CIK 0000320193"
  },
  "notes": "A large listed company with a stable LEI; name screening may produce potential matches on common words, which is acceptable.",
  "assertions": [
    {
      "id": "ORG-01",
      "step": "S4",
      "description": "GLEIF HTTP status",
      "path": "/values/S4/gleif_http_status",
      "required": true,
      "check": "equals",
      "expect": 200,
      "source": "https://api.gleif.org/api/v1/lei-records/HWUPKR0MPOU8FGXBT394"
    },
    {
      "id": "ORG-02",
      "step": "S4",
      "description": "LEI",
      "path": "/values/S4/lei",
      "required": true,
      "check": "equals",
      "expect": "HWUPKR0MPOU8FGXBT394"
    },
    {
      "id": "ORG-03",
      "step": "S4",
      "description": "legal name",
      "path": "/values/S4/legal_name",
      "required": true,
      "check": "equals",
      "expect": "Apple Inc."
    },
    {
      "id": "ORG-04",
      "step": "S4",
      "description": "jurisdiction",
      "path": "/values/S4/jurisdiction",
      "required": true,
      "check": "equals",
      "expect": "US-CA"
    },
    {
      "id": "ORG-05",
      "step": "S4",
      "description": "registration status",
      "path": "/values/S4/registration_status",
      "required": true,
      "check": "equals",
      "expect": "ISSUED"
    },
    {
      "id": "ORG-06",
      "step": "S1",
      "description": "SEC source authority",
      "path": "/values/S1/sec_source_authority",
      "required": true,
      "check": "equals",
      "expect": "securities_filings"
    },
    {
      "id": "ORG-07",
      "step": "S2",
      "description": "EDGAR company page HTTP status after redirect",
      "path": "/values/S2/edgar_company_page_http_status_after_redirect",
      "required": true,
      "check": "equals",
      "expect": 200,
      "note": "EDGAR requires a descriptive User-Agent with a contact email"
    },
    {
      "id": "ORG-08",
      "step": "S6",
      "description": "OFAC + UN list files downloaded",
      "path": "/values/S6/ofac_un_list_files_downloaded",
      "required": true,
      "check": "equals",
      "expect": 200
    },
    {
      "id": "ORG-09",
      "step": "S6",
      "description": "screening result",
      "path": "/values/S6/screening_result",
      "required": true,
      "check": "in",
      "expect": [
        "NO MATCH",
        "POTENTIAL MATCH (requires human review)"
      ]
    }
  ]
}
