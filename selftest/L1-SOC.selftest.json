{
  "schema": "l1-selftest/1.3",
  "agent": "L1-SOC",
  "agent_version": "1.3.0",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "https://bsky.app/profile/bsky.app",
  "skip_steps": [
    "S5",
    "S6"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {
    "16": "10 most recent"
  },
  "notes": "Bluesky exposes a public, keyless API, so this test works without a browser; the mode will be ASSISTED on hosts without CAP-BROWSER and that is expected.",
  "assertions": [
    {
      "id": "SOC-01",
      "step": "S1",
      "description": "public profile API HTTP status (platform public API source, 9.2)",
      "path": "/values/S1/public_profile_api_http_status_platform_public_api_source_9_2",
      "required": true,
      "check": "equals",
      "expect": 200,
      "source": "https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?actor=bsky.app"
    },
    {
      "id": "SOC-02",
      "step": "S3",
      "description": "handle",
      "path": "/values/S3/handle",
      "required": true,
      "check": "equals",
      "expect": "bsky.app"
    },
    {
      "id": "SOC-03",
      "step": "S3",
      "description": "stable ID (DID)",
      "path": "/values/S3/stable_id_did",
      "required": true,
      "check": "equals",
      "expect": "did:plc:z72i7hdynmk6r22z27h6tvur"
    },
    {
      "id": "SOC-04",
      "step": "S3",
      "description": "createdAt starts with",
      "path": "/values/S3/createdat_starts_with",
      "required": true,
      "check": "startswith",
      "expect": "2023-04-12"
    },
    {
      "id": "SOC-05",
      "step": "S2",
      "description": "profile page HTTP status",
      "path": "/values/S2/profile_page_http_status",
      "required": true,
      "check": "equals",
      "expect": 200
    },
    {
      "id": "SOC-06",
      "step": "S4",
      "description": "author feed items (limit 10)",
      "path": "/values/S4/author_feed_items_limit_10",
      "required": true,
      "check": "gte",
      "expect": 5,
      "source": "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=bsky.app&limit=10"
    },
    {
      "id": "SOC-07",
      "step": "S4",
      "description": "feed item uris",
      "path": "/values/S4/feed_item_uris",
      "required": true,
      "check": "all_startswith",
      "expect": "at://did:plc:z72i7hdynmk6r22z27h6tvur/"
    },
    {
      "id": "SOC-08",
      "step": "S9",
      "description": "drift line printed",
      "path": "/values/S9/drift_line_printed",
      "required": true,
      "check": "exists",
      "expect": true
    }
  ]
}
