{
  "schema": "l1-selftest/1.3",
  "agent": "L1-CRY",
  "agent_version": "1.3.0",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "tests/fixtures/crypto-transactions.json",
  "skip_steps": [
    "S2",
    "S5",
    "S6",
    "S7",
    "S8"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {},
  "notes": "Offline transaction fixtures avoid mutable explorer counts and the exceptional genesis-block subsidy. The fixture checks representation and target-address arithmetic only; provider capture and chain support need separate live smoke tests.",
  "assertions": [
    {
      "id": "CRY-01",
      "step": "S1",
      "description": "chain",
      "path": "/values/S1/chain",
      "required": true,
      "check": "equals",
      "expect": "BTC"
    },
    {
      "id": "CRY-02",
      "step": "S1",
      "description": "format",
      "path": "/values/S1/format",
      "required": true,
      "check": "equals",
      "expect": "P2PKH"
    },
    {
      "id": "CRY-03",
      "step": "S1",
      "description": "base58check valid",
      "path": "/values/S1/base58check_valid",
      "required": true,
      "check": "equals",
      "expect": true
    },
    {
      "id": "CRY-04",
      "step": "S3",
      "description": "multi input fixture input count",
      "path": "/values/S3/multi_input_fixture_input_count",
      "required": true,
      "check": "equals",
      "expect": 2
    },
    {
      "id": "CRY-05",
      "step": "S3",
      "description": "multi input fixture output count",
      "path": "/values/S3/multi_input_fixture_output_count",
      "required": true,
      "check": "equals",
      "expect": 3
    },
    {
      "id": "CRY-06",
      "step": "S3",
      "description": "target net delta satoshi",
      "path": "/values/S3/target_net_delta_satoshi",
      "required": true,
      "check": "equals",
      "expect": -62000
    },
    {
      "id": "CRY-07",
      "step": "S4",
      "description": "per counterparty allocation",
      "path": "/values/S4/per_counterparty_allocation",
      "required": true,
      "check": "equals",
      "expect": "not established"
    },
    {
      "id": "CRY-08",
      "step": "S4",
      "description": "coverage",
      "path": "/values/S4/coverage",
      "required": true,
      "check": "equals",
      "expect": "sampled"
    },
    {
      "id": "CRY-09",
      "step": "S3",
      "description": "self transfer net delta satoshi",
      "path": "/values/S3/self_transfer_net_delta_satoshi",
      "required": true,
      "check": "equals",
      "expect": -1000
    }
  ]
}
