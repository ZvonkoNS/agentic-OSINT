{
  "schema": "l1-selftest/1.3",
  "agent": "L1-EML",
  "agent_version": "1.3.0",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "selftest@example.com",
  "skip_steps": [
    "S6",
    "S7"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {},
  "notes": "No third-party sweep for a test address.",
  "assertions": [
    {
      "id": "EML-01",
      "step": "S1",
      "description": "local part",
      "path": "/values/S1/local_part",
      "required": true,
      "check": "equals",
      "expect": "selftest"
    },
    {
      "id": "EML-02",
      "step": "S1",
      "description": "domain",
      "path": "/values/S1/domain",
      "required": true,
      "check": "equals",
      "expect": "example.com"
    },
    {
      "id": "EML-03",
      "step": "S1",
      "description": "role address",
      "path": "/values/S1/role_address",
      "required": true,
      "check": "equals",
      "expect": false
    },
    {
      "id": "EML-04",
      "step": "S2",
      "description": "mail routing classification",
      "path": "/values/S2/mail_routing_classification",
      "required": true,
      "check": "in",
      "expect": [
        "explicit_null_mx",
        "no_mx_with_address_fallback",
        "mx_present"
      ]
    },
    {
      "id": "EML-05",
      "step": "S2",
      "description": "RDAP registration date",
      "path": "/values/S2/rdap_registration_date",
      "required": true,
      "check": "equals",
      "expect": "1995-08-14T04:00:00Z"
    },
    {
      "id": "EML-06",
      "step": "S3",
      "description": "disposable classification",
      "path": "/values/S3/disposable_classification",
      "required": true,
      "check": "equals",
      "expect": false
    },
    {
      "id": "EML-07",
      "step": "S4",
      "description": "Gravatar SHA256 identifier",
      "path": "/values/S4/gravatar_sha256_identifier",
      "required": true,
      "check": "equals",
      "expect": "372d59d467e41413a6bf12a595d0cdcf81dbaa71eb58f1579bb25309bc68f97b"
    },
    {
      "id": "EML-08",
      "step": "S5",
      "description": "HIBP step status without key",
      "path": "/values/S5/hibp_step_status_without_key",
      "required": true,
      "check": "equals",
      "expect": "DEFERRED",
      "note": "with an agency key, use account-exists@hibp-integration-tests.com and expect >= 1 breach"
    }
  ]
}
