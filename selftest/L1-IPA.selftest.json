{
  "schema": "l1-selftest/1.3",
  "agent": "L1-IPA",
  "agent_version": "1.3.6",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "1.1.1.1",
  "skip_steps": [
    "S8",
    "S9"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {
    "16": "2026-01-01T00:00:00Z"
  },
  "notes": "Cloudflare's public resolver; registration and routing are stable.",
  "assertions": [
    {
      "id": "IPA-01",
      "step": "S1",
      "description": "classification",
      "path": "/values/S1/classification",
      "required": true,
      "check": "equals",
      "expect": "public"
    },
    {
      "id": "IPA-02",
      "step": "S2",
      "description": "RDAP name",
      "path": "/values/S2/rdap_name",
      "required": true,
      "check": "equals",
      "expect": "APNIC-LABS"
    },
    {
      "id": "IPA-03",
      "step": "S2",
      "description": "RDAP range",
      "path": "/values/S2/rdap_range",
      "required": true,
      "check": "equals",
      "expect": "1.1.1.0-1.1.1.255"
    },
    {
      "id": "IPA-04",
      "step": "S3",
      "description": "ASN",
      "path": "/values/S3/asn",
      "required": true,
      "check": "equals",
      "expect": 13335
    },
    {
      "id": "IPA-05",
      "step": "S3",
      "description": "prefix",
      "path": "/values/S3/prefix",
      "required": true,
      "check": "equals",
      "expect": "1.1.1.0/24"
    },
    {
      "id": "IPA-06",
      "step": "S3",
      "description": "routing history at incident timestamp shows ASN",
      "path": "/values/S3/routing_history_at_incident_timestamp_shows_asn",
      "required": true,
      "check": "equals",
      "expect": 13335
    },
    {
      "id": "IPA-07",
      "step": "S4",
      "description": "PTR",
      "path": "/values/S4/ptr",
      "required": true,
      "check": "equals",
      "expect": "one.one.one.one"
    },
    {
      "id": "IPA-08",
      "step": "S5",
      "description": "two geolocation providers responded",
      "path": "/values/S5/two_geolocation_providers_responded",
      "required": true,
      "check": "equals",
      "expect": true
    },
    {
      "id": "IPA-09",
      "step": "S6",
      "description": "in Tor bulk exit list",
      "path": "/values/S6/in_tor_bulk_exit_list",
      "required": true,
      "check": "equals",
      "expect": false
    },
    {
      "id": "IPA-10",
      "step": "S6",
      "description": "ExoneraTor resolution",
      "path": "/values/S6/exonerator_resolution",
      "required": true,
      "check": "equals",
      "expect": "date"
    },
    {
      "id": "IPA-11",
      "step": "S7",
      "description": "Shodan InternetDB hostnames contain",
      "path": "/values/S7/shodan_internetdb_hostnames_contain",
      "required": true,
      "check": "contains",
      "expect": "one.one.one.one",
      "may_drift": true
    },
    {
      "id": "IPA-12",
      "step": "unit",
      "description": "validation routine applied to 192.168.1.1 (code only, no network)",
      "path": "/values/unit/validation_routine_applied_to_192_168_1_1_code_only_no_network",
      "required": true,
      "check": "equals",
      "expect": "NOT-INVESTIGABLE"
    }
  ]
}
