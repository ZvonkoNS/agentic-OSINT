{
  "schema": "l1-selftest/1.3",
  "agent": "L1-VID",
  "agent_version": "1.3.0",
  "historical_baseline_date": "2026-10-28",
  "validation": {
    "live_provider_verified": false,
    "host_matrix": [],
    "scope": "Compares supplied observations; does not generate them or certify a host."
  },
  "target": "https://www.youtube.com/watch?v=jNQXAC9IVRw",
  "skip_steps": [
    "S5",
    "S8",
    "S9"
  ],
  "caps": {},
  "sub_skips": {},
  "intake_overrides": {
    "16": "N",
    "17": "N"
  },
  "notes": "The first video uploaded to YouTube; public since 2005.",
  "assertions": [
    {
      "id": "VID-01",
      "step": "S1",
      "description": "video id",
      "path": "/values/S1/video_id",
      "required": true,
      "check": "equals",
      "expect": "jNQXAC9IVRw"
    },
    {
      "id": "VID-02",
      "step": "S3",
      "description": "oEmbed HTTP status",
      "path": "/values/S3/oembed_http_status",
      "required": true,
      "check": "equals",
      "expect": 200
    },
    {
      "id": "VID-03",
      "step": "S3",
      "description": "oEmbed title",
      "path": "/values/S3/oembed_title",
      "required": true,
      "check": "equals",
      "expect": "Me at the zoo"
    },
    {
      "id": "VID-04",
      "step": "S3",
      "description": "oEmbed author_name",
      "path": "/values/S3/oembed_author_name",
      "required": true,
      "check": "equals",
      "expect": "jawed"
    },
    {
      "id": "VID-05",
      "step": "S3",
      "description": "oEmbed author_url",
      "path": "/values/S3/oembed_author_url",
      "required": true,
      "check": "equals",
      "expect": "https://www.youtube.com/@jawed"
    },
    {
      "id": "VID-06",
      "step": "S2",
      "description": "watch page HTTP status",
      "path": "/values/S2/watch_page_http_status",
      "required": true,
      "check": "equals",
      "expect": 200
    },
    {
      "id": "VID-07",
      "step": "S4",
      "description": "yt-dlp upload_date (if yt-dlp ran)",
      "path": "/values/S4/yt_dlp_upload_date_if_yt_dlp_ran",
      "required": true,
      "check": "equals",
      "expect": "20050423",
      "inconclusive_if_blocked": true
    },
    {
      "id": "VID-08",
      "step": "S4",
      "description": "yt-dlp duration seconds (if yt-dlp ran)",
      "path": "/values/S4/yt_dlp_duration_seconds_if_yt_dlp_ran",
      "required": true,
      "check": "between",
      "expect": [
        18,
        20
      ],
      "inconclusive_if_blocked": true
    },
    {
      "id": "VID-09",
      "step": "S10",
      "description": "drift line printed",
      "path": "/values/S10/drift_line_printed",
      "required": true,
      "check": "exists",
      "expect": true
    }
  ]
}
