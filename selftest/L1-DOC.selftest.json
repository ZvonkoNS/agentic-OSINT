      "step": "S1",
      "description": "SHA-256",
      "path": "/values/S1/sha_256",
      "required": true,
      "check": "equals",
      "expect": "07abda698a6064a8a199d3580e0809b07b1320b4cb533522ca4e0f9e536d4719"
    },
    {
      "id": "DOC-02",
      "step": "S1",
      "description": "size bytes",
      "path": "/values/S1/size_bytes",
      "required": true,
      "check": "equals",
      "expect": 2012
