    {
      "id": "DOC-03",
      "step": "S1",
      "description": "true type",
      "path": "/values/S1/true_type",
      "required": true,
      "check": "equals",
      "expect": "application/pdf"
    },
    {
      "id": "DOC-04",
      "step": "S2",
      "description": "page count",
      "path": "/values/S2/page_count",
      "required": true,
      "check": "equals",
      "expect": 2
