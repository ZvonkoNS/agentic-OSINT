{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:selftest:1.3",
  "title": "agentic-OSINT selftest 1.3",
  "type": "object",
  "properties": {
    "schema": {
      "const": "l1-selftest/1.3"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": {
      "type": "string",
      "minLength": 1
    },
    "historical_baseline_date": {
      "type": "string",
      "format": "date"
    },
    "validation": {
      "type": "object",
      "properties": {
        "live_provider_verified": {
          "const": false
        },
        "host_matrix": {
          "type": "array",
          "maxItems": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "live_provider_verified",
        "host_matrix",
        "scope"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "skip_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "caps": {
      "type": "object"
    },
    "sub_skips": {
      "type": "object"
    },
    "intake_overrides": {
      "type": "object"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2,}$"
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/values/(?:[^~]|~[01])+$"
          },
          "required": {
            "type": "boolean"
          },
          "check": {
            "enum": [
              "equals",
              "contains",
              "startswith",
              "all_startswith",
              "matches",
              "gte",
              "lte",
              "between",
              "in",
              "exists"
            ]
          },
          "expect": {},
          "may_drift": {
            "type": "boolean"
          },
          "inconclusive_if_blocked": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "step",
          "description",
          "path",
          "required",
          "check",
          "expect"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "check": {
                  "enum": [
                    "gte",
                    "lte"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "check": {
                  "const": "between"
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "check": {
                  "const": "in"
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "check": {
                  "const": "exists"
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "check": {
                  "enum": [
                    "startswith",
                    "all_startswith",
                    "matches"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "agent",
    "agent_version",
    "historical_baseline_date",
    "validation",
    "target",
    "skip_steps",
    "caps",
    "sub_skips",
    "intake_overrides",
    "notes",
    "assertions"
  ],
  "additionalProperties": false
}
