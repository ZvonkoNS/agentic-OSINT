{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:claim:1.3",
  "title": "agentic-OSINT claim 1.3",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CL-[1-9][0-9]*$"
    },
    "kind": {
      "enum": [
        "source_value",
        "analysis"
      ]
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[1-9][0-9]*$"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "text"
              ]
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "json"
              ]
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~]|~[01])*)*$"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value": {},
    "text": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "evidence_id",
    "file",
    "selector",
    "value"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_value"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "text"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "analysis"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
