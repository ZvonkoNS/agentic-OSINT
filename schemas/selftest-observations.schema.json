{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:selftest-observations:1.3",
  "title": "agentic-OSINT selftest-observations 1.3",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agentic-osint/observations/1.3"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "run_kind": {
      "enum": [
        "offline_fixture",
        "live_smoke"
      ]
    },
    "values": {
      "type": "object"
    },
    "availability": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "OBSERVED",
              "BLOCKED",
              "NOT_RUN",
              "ERROR"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "baseline_change_review": {
            "type": "object",
            "properties": {
              "confirmed": {
                "type": "boolean"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "confirmed",
              "reviewer",
              "reason",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "agent",
    "run_kind",
    "values",
    "availability"
  ],
  "additionalProperties": false
}
