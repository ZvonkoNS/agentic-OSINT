{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:evidence:1.3",
  "title": "agentic-OSINT evidence 1.3",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-[1-9][0-9]*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "file",
            "url",
            "derived"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "size",
          "sha256",
          "mime_type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "capture_level": {
      "enum": [
        "A1",
        "A2",
        "B",
        "T",
        "D"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "provisional",
        "mismatch",
        "restricted"
      ]
    },
    "capture_started_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "capture_finished_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "expected_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "derivation": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "source",
    "files",
    "capture_level",
    "status",
    "capture_started_utc",
    "capture_finished_utc",
    "expected_sha256",
    "derivation"
  ],
  "additionalProperties": false
}
