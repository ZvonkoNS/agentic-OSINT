{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:checkpoint:1.3",
  "title": "agentic-OSINT checkpoint 1.3",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agentic-osint/checkpoint/1.3"
    },
    "pack_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "ledger_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "pack_id",
    "created_utc",
    "case",
    "files",
    "ledger_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "agentic-osint/case/1.3"
        },
        "pack_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_reference": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "version",
            "revision"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        "created_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "allowed_urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 0
            },
            "allow_http": {
              "type": "boolean"
            },
            "third_party_lookups": {
              "type": "boolean"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "max_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "allowed_urls",
            "allow_http",
            "third_party_lookups",
            "max_bytes",
            "max_requests"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "pack_id",
        "case_reference",
        "agent",
        "target",
        "created_utc",
        "scope",
        "evidence",
        "claims",
        "steps"
      ],
      "additionalProperties": false,
      "$defs": {
        "evidence": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^EV-[1-9][0-9]*$"
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "file",
                    "url",
                    "derived"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mime_type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "size",
                  "sha256",
                  "mime_type"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "capture_level": {
              "enum": [
                "A1",
                "A2",
                "B",
                "T",
                "D"
              ]
            },
            "status": {
              "enum": [
                "verified",
                "provisional",
                "mismatch",
                "restricted"
              ]
            },
            "capture_started_utc": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "capture_finished_utc": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "expected_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "derivation": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "source",
            "files",
            "capture_level",
            "status",
            "capture_started_utc",
            "capture_finished_utc",
            "expected_sha256",
            "derivation"
          ],
          "additionalProperties": false
        },
        "claim": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^CL-[1-9][0-9]*$"
            },
            "kind": {
              "enum": [
                "source_value",
                "analysis"
              ]
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^EV-[1-9][0-9]*$"
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
            },
            "selector": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "text"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "json"
                      ]
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                    }
                  },
                  "required": [
                    "type",
                    "pointer"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "value": {},
            "text": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "evidence_id",
            "file",
            "selector",
            "value"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "source_value"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "text"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "analysis"
                  }
                }
              },
              "then": {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "step": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "required": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "PENDING",
                "DONE",
                "FAILED",
                "DEFERRED",
                "SKIPPED"
              ]
            }
          },
          "required": [
            "id",
            "required",
            "status"
          ],
          "additionalProperties": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EV-[1-9][0-9]*$"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "file",
                "url",
                "derived"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mime_type": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "size",
              "sha256",
              "mime_type"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "capture_level": {
          "enum": [
            "A1",
            "A2",
            "B",
            "T",
            "D"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "provisional",
            "mismatch",
            "restricted"
          ]
        },
        "capture_started_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "capture_finished_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivation": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "files",
        "capture_level",
        "status",
        "capture_started_utc",
        "capture_finished_utc",
        "expected_sha256",
        "derivation"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CL-[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "source_value",
            "analysis"
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[1-9][0-9]*$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
        },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "text"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "json"
                  ]
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                }
              },
              "required": [
                "type",
                "pointer"
              ],
              "additionalProperties": false
            }
          ]
        },
        "value": {},
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "evidence_id",
        "file",
        "selector",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source_value"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "text"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "analysis"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PENDING",
            "DONE",
            "FAILED",
            "DEFERRED",
            "SKIPPED"
          ]
        }
      },
      "required": [
        "id",
        "required",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
