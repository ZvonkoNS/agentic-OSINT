{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-osint:schema:event:1.3",
  "title": "agentic-OSINT event 1.3",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "time_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "sequence",
    "time_utc",
    "action",
    "actor",
    "details",
    "previous_hash",
    "hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "network_budget_reserved"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "requests"
            ],
            "properties": {
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "action": {
              "const": "network_budget_settled"
            }
          }
        },
        "then": {
          "properties": {
            "details": {
              "required": [
                "requests",
                "requests_observed"
              ],
              "properties": {
                "requests": {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 0
                },
                "requests_observed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "details": {
              "not": {
                "required": [
                  "requests"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
